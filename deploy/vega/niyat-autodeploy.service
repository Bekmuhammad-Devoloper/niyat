[Unit]
Description=Niyat avtodeploy (GitHub main branchini tortib oladi)
After=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
Environment=PM2_HOME=/root/.pm2
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/flock -n /run/niyat-autodeploy.lock /opt/niyat/autodeploy.sh
